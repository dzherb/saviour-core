{
  "app": {
    "instance": "dev_local",
    "startup_timeout": "10s",
    "shutdown_timeout": "60s"
  },
  "logger": {
    "level": "debug"
  },
  "secret_key": "unsecure_key",
  "server": {
    "host": "localhost",
    "port": 8080,
    "read_header_timeout": "10s",
    "api": {
      "response_timeout": "10s",
      "debug_log_processed_requests": true,
      "auth": {
        "access_token_secret": "unsecure_access_secret",
        "refresh_token_secret": "unsecure_refresh_secret"
      }
    }
  },
  "db": {
    "engine": "sqlite",
    "dsn": "file:sqlite.db?_pragma=foreign_keys(1)&_pragma=journal_mode(WAL)&_pragma=busy_timeout(5000)"
  }
}